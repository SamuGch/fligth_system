# URL pública del backend. Debe incluir el prefijo /api.
# Para desarrollo local: http://localhost:8080/api
# Para el backend desplegado: https://fly.astracode.org/api
VITE_API_URL=http://localhost:8080/api

# Configuración pública de Supabase para el navegador.
# Usa la URL del proyecto y la publishable/anon key; nunca una service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Debe estar registrado en Supabase Authentication > URL Configuration.
# Desarrollo: http://localhost:5173/auth/callback
# Produccion: https://fly.astracode.org/auth/callback
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Las credenciales de Postgres, JWT_SECRET, DBUSER, DBNAME y PORT pertenecen
# únicamente al contenedor del backend y no deben agregarse aquí.
